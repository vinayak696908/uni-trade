# Copy this file to ".env" in the project root and fill in your own values.
# .env is git-ignored. Spring Boot reads it at startup (see application.properties);
# real environment variables override anything written here.
# Format: KEY=VALUE, one per line, no quotes. Avoid backslashes (\) in values.

# --- MySQL ------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/unitrade?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=unitrade
DB_PASSWORD=change-me-to-a-strong-password

# Tests use a separate database (created automatically). Defaults to DB_USERNAME / DB_PASSWORD.
TEST_DB_URL=jdbc:mysql://localhost:3306/unitrade_test?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Server -----------------------------------------------------------------
PORT=8080
# true in production (HTTPS only). Keep false for http://localhost development.
COOKIE_SECURE=false
UPLOAD_DIR=uploads

# --- Development-only demo data ------------------------------------------------
# Inserts sample listings when the products table is empty. NEVER enable in production.
SEED_DEMO_DATA=true
# Optional: lets you log in as the demo sellers (ananya.demo@example.com, rohan.demo@example.com,
# kavya.demo@example.com). Leave empty to give them random, unusable passwords.
SEED_DEMO_PASSWORD=
# Optional: creates (or promotes) an administrator account. Password must be 12+ characters.
# There is no default admin; choose your own values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
